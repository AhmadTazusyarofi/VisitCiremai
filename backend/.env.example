# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# `.env` tidak ikut ter-commit (lihat .gitignore).

PORT=4000
NODE_ENV=development

# Database MySQL (XAMPP: user root tanpa password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=visitciremai

# Rahasia penandatangan JWT — WAJIB diganti, minimal 32 karakter.
# Contoh cara membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Origin frontend yang diizinkan memanggil API (dipisah koma bila lebih dari satu)
CORS_ORIGIN=http://localhost:5173

# Akun admin awal yang dibuat oleh `npm run seed --workspace backend`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ubah-password-ini
