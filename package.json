{
  "name": "visit-ciremai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "start": "npm run start --workspace backend",
    "seed": "npm run seed --workspace backend",
    "test": "npm run test --workspace frontend",
    "lint": "oxlint",
    "preview": "npm run preview --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxlint": "^1.75.0"
  }
}
