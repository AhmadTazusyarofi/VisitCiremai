# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#
# PENTING: seluruh variabel VITE_* ikut ter-bundle ke JavaScript yang dikirim
# ke browser, jadi TIDAK BOLEH berisi rahasia (password, API key, token).
# Rahasia disimpan di backend/.env.

# --- API ---
# Path/URL yang dipanggil frontend. Biarkan "/api" bila API disajikan pada
# origin yang sama (dev memakai proxy Vite, produksi memakai reverse proxy).
# Isi URL penuh bila API berada di domain lain, mis. https://api.visitciremai.com
VITE_API_URL=/api

# Tujuan proxy Vite saat menjalankan `npm run dev` — harus sama dengan PORT
# pada backend/.env
VITE_API_PROXY_TARGET=http://localhost:4000

# --- Identitas situs (dipakai untuk Open Graph & canonical) ---
VITE_SITE_NAME=VisitCiremai
VITE_SITE_URL=https://visitciremai.com
VITE_OG_IMAGE=/img/hero.png

# --- Kontak yang tampil di situs ---
# Nomor WhatsApp format internasional tanpa tanda + dan tanpa spasi
VITE_WHATSAPP_NUMBER=6285520752899
VITE_CONTACT_PHONE=+62 855-2075-2899
VITE_CONTACT_EMAIL=jessa@visitciremai.com
VITE_CONTACT_ADDRESS=Kaki Gunung Ciremai, Majalengka - Jawa Barat

# Kata kunci lokasi untuk embed Google Maps
VITE_MAP_QUERY=Gunung Ciremai, Majalengka, Jawa Barat
